[Unit]
Description=Open Wooting Background Service
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/open-wbg-service run
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=graphical-session.target
